[gd_resource type="Resource" script_class="RouteData" format=3]

[ext_resource type="Script" path="res://events/route_data.gd" id="1_route"]
[ext_resource type="Script" path="res://events/route_entry.gd" id="2_entry"]
[ext_resource type="PackedScene" path="res://events/test_event.tscn" id="3_test"]

[sub_resource type="Resource" id="Resource_a"]
script = ExtResource("2_entry")
event_scene = ExtResource("3_test")
trigger_distance = 1200.0
warning_distance = -1.0
params = {}

[sub_resource type="Resource" id="Resource_b"]
script = ExtResource("2_entry")
event_scene = ExtResource("3_test")
trigger_distance = 2800.0
warning_distance = -1.0
params = {}

[sub_resource type="Resource" id="Resource_c"]
script = ExtResource("2_entry")
event_scene = ExtResource("3_test")
trigger_distance = 4500.0
warning_distance = -1.0
params = {}

[resource]
script = ExtResource("1_route")
entries = Array[ExtResource("2_entry")]([SubResource("Resource_a"), SubResource("Resource_b"), SubResource("Resource_c")])
