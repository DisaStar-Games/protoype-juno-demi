; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="prototype-juno-demi"
run/main_scene="res://levels/TrainBlockout.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TrainState="*res://autoload/train_state.tscn"
GameState="*res://autoload/game_state.gd"
Inventory="*res://autoload/inventory.gd"
Journey="*res://autoload/journey.gd"
EventManager="*res://events/event_manager.tscn"
HallucinationOverlay="*res://ui/hallucination_overlay.tscn"
ScreenEffects="*res://ui/screen_effects.tscn"
EndScreen="*res://ui/end_screen.tscn"
DebugPanel="*res://ui/debug_panel.tscn"
EventsDebugPanel="*res://ui/events_debug_panel.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="prototype-juno-demi"

